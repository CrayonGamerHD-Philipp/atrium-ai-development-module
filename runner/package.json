{
	"name": "atrium-aidev-runner",
	"private": true,
	"version": "0.6.0",
	"description": "Runner für das Atrium-Modul „KI-Entwicklung“ (aidev): führt Agent-Läufe (Claude Code, Codex, Gemini, OpenAI-kompatibel) in git-Worktrees aus",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"atrium-aidev-runner": "dist/main.js"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"build:sea": "node scripts/build-sea.mjs",
		"start": "node dist/main.js",
		"dev": "tsx src/main.ts",
		"test": "vitest run",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"cross-spawn": "^7.0.6",
		"zod": "^4.6.5"
	},
	"optionalDependencies": {
		"node-pty": "^1.1.0"
	},
	"devDependencies": {
		"@types/cross-spawn": "^6.0.6",
		"@types/node": "^22.19.0",
		"esbuild": "^0.28.2",
		"postject": "^1.0.0-alpha.6",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.1.1"
	}
}
