{
	"schema": 1,
	"id": "aidev",
	"name": "KI-Entwicklung",
	"description": "Vibe-Coding im Browser: GitHub-Projekte anlegen, Aufträge an Coding-Agents (Claude Code, Codex, Gemini, OpenAI-kompatibel) geben, die auf eigenen Runnern selbstständig arbeiten, committen und PRs öffnen – mit Live-Log, Diff, Editor und Terminal",
	"version": "0.2.0",
	"core": ">=2.0.0-0 <3.0.0",
	"dependencies": {},
	"optionalDependencies": {},
	"permissions": [
		"aidev.account.manage",
		"aidev.project.manage",
		"aidev.project.view",
		"aidev.runner.connect",
		"aidev.runner.manage",
		"aidev.settings.manage",
		"aidev.task.create",
		"aidev.task.manage",
		"aidev.workspace.files",
		"aidev.workspace.terminal"
	],
	"npm": {
		"@xterm/xterm": "6.0.0",
		"@xterm/addon-fit": "0.11.0",
		"codemirror": "6.0.2",
		"@codemirror/view": "6.43.15",
		"@codemirror/state": "6.7.6",
		"@codemirror/language-data": "6.5.2",
		"@codemirror/theme-one-dark": "6.1.3"
	}
}
